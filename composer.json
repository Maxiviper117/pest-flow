{
    "name": "pest-flow/pest-flow",
    "description": "A Pest 5 plugin for executable behaviour specifications.",
    "keywords": [
        "php",
        "pest",
        "testing",
        "bdd",
        "behaviour-driven-development"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "pestphp/pest": "^5.0.0",
        "pestphp/pest-plugin": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "Pest\\Flow\\": "src/"
        },
        "files": [
            "src/Autoload.php"
        ]
    },
    "require-dev": {
        "pestphp/pest-dev-tools": "^5.0.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": "pint",
        "test:refacto": "rector --dry-run",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --ansi",
        "test:unit": "pest --colors=always",
        "test": [
            "@test:refacto",
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
